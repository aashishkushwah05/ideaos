# Copy this file to .env (or set these as real environment variables) and
# fill in only the provider(s) you actually want to use. NEVER commit a
# real .env file — it's excluded in .gitignore.
#
# Preferred: configure provider API keys from IdeaOS Settings instead of
# here — they're stored encrypted in the local database and take priority
# over these env vars (see app/model_providers.py). These env vars exist
# as a fallback / for scripted local setups.

# Which provider is "active" by default when a task doesn't specify one.
# One of: openai, kimi, nvidia, gemini, claude, ollama, custom
IDEAOS_AI_PROVIDER=

# Per-provider config (repeat this block for whichever providers you use):
#   IDEAOS_OPENAI_MODEL=
#   IDEAOS_OPENAI_ENDPOINT=
#   IDEAOS_OPENAI_API_KEY=
#   IDEAOS_OPENAI_TASKS=simple,organization,agent,reasoning
#
#   IDEAOS_KIMI_MODEL=
#   IDEAOS_KIMI_ENDPOINT=
#   IDEAOS_KIMI_API_KEY=
#
#   IDEAOS_NVIDIA_MODEL=
#   IDEAOS_NVIDIA_ENDPOINT=
#   IDEAOS_NVIDIA_API_KEY=
#
#   IDEAOS_GEMINI_MODEL=
#   IDEAOS_GEMINI_ENDPOINT=
#   IDEAOS_GEMINI_API_KEY=
#
#   IDEAOS_CLAUDE_MODEL=
#   IDEAOS_CLAUDE_ENDPOINT=
#   IDEAOS_CLAUDE_API_KEY=
#
#   IDEAOS_OLLAMA_MODEL=
#   IDEAOS_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
#   # Ollama runs locally and needs no API key.
#
#   IDEAOS_CUSTOM_MODEL=
#   IDEAOS_CUSTOM_ENDPOINT=
#   IDEAOS_CUSTOM_API_KEY=

# Legacy single-provider fallback (still supported for back-compat with
# earlier phases; per-provider vars above take precedence):
# IDEAOS_AI_MODEL=
# IDEAOS_AI_ENDPOINT=
# IDEAOS_AI_API_KEY=
# IDEAOS_AI_TASKS=
